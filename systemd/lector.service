[Unit]
Description=lector voice-in / read-aloud daemon
After=graphical-session.target

[Service]
ExecStart=%h/Repos/lector/.venv/bin/lectord
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1
# Optional: LECTOR_CLOUD_BASE_URL / _MODEL / _API_KEY, for anyone who would rather
# keep the cloud lane out of config.toml. Leading '-' means "fine if absent".
EnvironmentFile=-%h/.config/lector/lector.env

[Install]
WantedBy=default.target
